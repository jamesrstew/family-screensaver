{
  "name": "family-screensaver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:lan": "echo 'Open to the network: set FAMILY_KEY in .env.local first.' && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "key": "node scripts/key.mjs",
    "notebook:push": "tsx scripts/notebook-push.mts",
    "nature:push": "node scripts/nature-push.mjs",
    "nest:connect": "node scripts/nest-connect.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "ical.js": "^2.2.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  }
}
