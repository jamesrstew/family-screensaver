# The one secret. A few plain words, easy to type with a TV remote.
# Generate: pnpm key. Rotating it signs every device out.
# Without it, local dev is open and production is locked.
FAMILY_KEY=

# Where the family lives (city-level is plenty). Used for the weather and dateline.
HOME_PLACE="Springfield, Illinois"
HOME_LAT=
HOME_LON=
HOME_TIME_ZONE=America/Chicago

# Google Calendar → the calendar's settings → "Secret address in iCal format".
# Several calendars: separate with commas. Treat these URLs like passwords.
# Dev sample: file:///absolute/path/to/content/fixtures/family.ics
CALENDAR_ICS_URLS=

# The voice (OpenAI Realtime). Leave empty and the app stays quiet.
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Upstash Redis via the Vercel Marketplace (vercel env pull sets these).
# Holds the latest show request and the notebook. Without it, dev uses memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: the Nest thermostats ("68° inside" on home; the voice can say each
# room's temperature). Set by `pnpm nest:connect`; see README: Nest thermostats.
# Leave empty and there's simply no indoor reading.
NEST_PROJECT_ID=
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_REFRESH_TOKEN=
